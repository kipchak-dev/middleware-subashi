{
    "name": "kipchak/middleware-subashi",
    "type": "middleware",
    "description": "A WAF for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "HTTP",
        "Microservices",
        "Mamluk",
        "AuthN",
        "AuthZ",
        "JWKS",
        "API Keys"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Middleware\\Subashi\\": "src/",
            "Kipchak\\Middleware\\Subashi\\tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "kipchak/core": "^2 || ^3",
        "kipchak/driver-config": "^1",
        "kipchak/driver-filecache": "^1",
        "kipchak/driver-logger": "^1",
        "kipchak/driver-memcached": "^1",
        "psr/clock": "^1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "extra": {
        "kipchak": {
            "type": "middleware",
            "config": "sample.config.php",
            "configName": "kipchak.subashi.php",
            "initialise": "\\Kipchak\\Middleware\\Subashi\\Subashi::initialise($app);",
            "after": [
                "kipchak/middleware-auth-hmac",
                "kipchak/middleware-auth-jwks",
                "kipchak/middleware-auth-jwt",
                "kipchak/middleware-auth-key"
            ],
            "before": [
                "kipchak/middleware-opentelemetry",
                "kipchak/middleware-redaction"
            ],
            "docs": "https://kipchak.dev/docs/mw-subashi"
        }
    }
}
